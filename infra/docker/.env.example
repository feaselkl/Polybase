# Copy to .env (gitignored) and fill in. Defaults from docker-compose.yml are used if .env is missing.
# Anything in here gets read by the entrypoint at first boot, rendered into the
# init SQL templates via envsubst, and used to create database-scoped credentials
# inside the Scratch database. Secrets never end up in image layers.

# === SQL Server (local) ===
# Must satisfy SA password policy: 8+ chars, three of {upper, lower, digit, symbol}.
MSSQL_SA_PASSWORD=Polybase!Demo2025
# Used as ENCRYPTION BY PASSWORD on the Scratch database master key.
MASTER_KEY_PASSWORD=<<SomeSecureKey>>

# === PostgreSQL (local sidecar) ===
# Same values are passed to both containers so the SQL Server credential matches.
POSTGRES_USER=polybase
POSTGRES_PASSWORD=pgtestpwd

# === Second SQL Server instance (federated read demo) ===
# Login created on the remote SQL Server; the primary uses these to authenticate
# when querying ExternalExample.dbo.Eruption via the sqlserver:// connector.
# Must satisfy SQL Server password policy.
REMOTE_SQL_USER=polybase_reader
REMOTE_SQL_PASSWORD=PolybaseRemote!Demo2025

# === S3-compatible object storage (adobe/s3mock) ===
# adobe/s3mock accepts any access key / secret, so these are arbitrary
# alphanumeric strings shared between the s3-init upload sidecar and the
# SQL Server credential that authenticates against s3://s3:9191. Keep them
# alphanumeric — PolyBase rejects ':' in S3 access keys.
S3_ACCESS_KEY=polybases3key
S3_SECRET_KEY=polybases3secret

# === Cosmos DB (real secret) ===
COSMOS_USER=
COSMOS_KEY=

# === Azure Blob Storage SAS (real secret — token only, no leading '?') ===
AZURE_BLOB_SAS=

# === Azure Data Lake Storage SAS (real secret) ===
AZURE_ADLS_SAS=

# === Pre-flight / post-talk scripts (infra/preflight.sh, infra/posttalk.sh) ===
# These are NOT consumed by docker compose or the SQL Server containers.
# They override defaults in the helper scripts, which use az CLI to
# rotate SAS tokens / clean up CETAS exports.
# Leave commented to use the scripts' built-in defaults.
#
# SUBSCRIPTION pins az to the subscription that owns cspolybaseblob /
# cspolybaselake when your default az context is something else. Use the
# subscription name or id (whichever you'd pass to `az account set`).
#SUBSCRIPTION=My Azure Subscription Name
#BLOB_ACCOUNT=cspolybaseblob
#LAKE_ACCOUNT=cspolybaselake
#CONTAINER=ncpop
#CETAS_PREFIX=exports/volcanoes/
#EXPIRY_DAYS=7
