-- Rendered with envsubst at first boot. Secrets come from .env (gitignored).
-- Each credential is guarded so a re-render after manual recovery is safe.
USE Scratch;
GO

OPEN MASTER KEY DECRYPTION BY PASSWORD = '${MASTER_KEY_PASSWORD}';
GO

-- Cosmos DB (MongoDB API). IDENTITY = your Cosmos account user; SECRET = primary or secondary key.
IF NOT EXISTS (SELECT 1 FROM sys.database_scoped_credentials WHERE name = N'CosmosCredential')
BEGIN
    CREATE DATABASE SCOPED CREDENTIAL CosmosCredential
    WITH IDENTITY = '${COSMOS_USER}',
         SECRET   = '${COSMOS_KEY}';
END
GO

-- Azure Blob Storage. IDENTITY is the literal 'SHARED ACCESS SIGNATURE' marker; SECRET is the SAS token (no leading '?').
IF NOT EXISTS (SELECT 1 FROM sys.database_scoped_credentials WHERE name = N'AzureStorageCredential')
BEGIN
    CREATE DATABASE SCOPED CREDENTIAL AzureStorageCredential
    WITH IDENTITY = 'SHARED ACCESS SIGNATURE',
         SECRET   = '${AZURE_BLOB_SAS}';
END
GO

-- Azure Data Lake Storage Gen2.
IF NOT EXISTS (SELECT 1 FROM sys.database_scoped_credentials WHERE name = N'DataLakeCredential')
BEGIN
    CREATE DATABASE SCOPED CREDENTIAL DataLakeCredential
    WITH IDENTITY = 'SHARED ACCESS SIGNATURE',
         SECRET   = '${AZURE_ADLS_SAS}';
END
GO

-- PostgreSQL (local sidecar). Matches the postgres container's POSTGRES_USER / POSTGRES_PASSWORD.
IF NOT EXISTS (SELECT 1 FROM sys.database_scoped_credentials WHERE name = N'PostgresVolcanoCredential')
BEGIN
    CREATE DATABASE SCOPED CREDENTIAL PostgresVolcanoCredential
    WITH IDENTITY = '${POSTGRES_USER}',
         SECRET   = '${POSTGRES_PASSWORD}';
END
GO

-- Second SQL Server instance (federated read demo). Matches the login created
-- on sqlserver-remote at first boot from REMOTE_SQL_USER / REMOTE_SQL_PASSWORD.
IF NOT EXISTS (SELECT 1 FROM sys.database_scoped_credentials WHERE name = N'RemoteSqlCredential')
BEGIN
    CREATE DATABASE SCOPED CREDENTIAL RemoteSqlCredential
    WITH IDENTITY = '${REMOTE_SQL_USER}',
         SECRET   = '${REMOTE_SQL_PASSWORD}';
END
GO

-- S3-compatible object storage (adobe/s3mock sidecar). PolyBase's S3 connector
-- expects IDENTITY = 'S3 Access Key' as a literal marker and SECRET formatted
-- as '<access-key>:<secret-key>'. Both halves come from .env.
IF NOT EXISTS (SELECT 1 FROM sys.database_scoped_credentials WHERE name = N'S3Credential')
BEGIN
    CREATE DATABASE SCOPED CREDENTIAL S3Credential
    WITH IDENTITY = 'S3 Access Key',
         SECRET   = '${S3_ACCESS_KEY}:${S3_SECRET_KEY}';
END
GO
